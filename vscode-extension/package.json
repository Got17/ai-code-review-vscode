{
  "name": "ws-code-review",
  "icon": "resources/icon.png",
  "publisher": "souvanxay",
  "displayName": "WebSharper Code Review",
  "description": "Offline AI code review for F# and WebSharper",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Got17/ai-code-review-vscode.git"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "AI"
  ],
  "keywords": [
    "F#",
    "WebSharper",
    "Ollama",
    "AI",
    "code review",
    "offline"
  ],
  "activationEvents": [
    "onLanguage:fsharp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "keybindings": [
      {
        "command": "extension.showSuggestion",
        "key": "ctrl+alt+r",
        "when": "editorLangId == fsharp && editorHasSelection && editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.showSuggestion",
          "when": "editorLangId == fsharp && editorHasSelection",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "WS Code Review",
      "properties": {
        "wsCodeReview.git.enable": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, accepted suggestions are snapshot-committed into a private shadow Git repo (keeps user repo untouched)."
        },
        "wsCodeReview.rag.enable": {
          "type": "boolean",
          "default": false,
          "description": "Use RAG to enrich reviews with built-in references packaged in the extension. If unavailable on your machine, it's skipped automatically."
        }
      }
    },
    "commands": [
      {
        "command": "extension.clearShadowHistory",
        "title": "WS Code Review: Clear Shadow Git History"
      },
      {
        "command": "extension.showShadowHistory",
        "title": "WS Code Review: Show Shadow Git History (Current File)"
      },
      {
        "command": "extension.showSuggestion",
        "title": "WS Code Review: Show Suggestion"
      },
      {
        "command": "extension.changeOllamaModel",
        "title": "WS Code Review: Change Ollama Model"
      },
      {
        "command": "extension.setAIPreferences",
        "title": "WS Code Review: Set AI Preferences"
      },
      {
        "command": "extension.showAIPreferences",
        "title": "WS Code Review: Show AI Preferences"
      },
      {
        "command": "extension.clearAIPreferences",
        "title": "WS Code Review: Clear AI Preferences"
      }
    ]
  },
  "scripts": {
    "qa:cycles": "madge --ts-config tsconfig.json --extensions ts,tsx --circular .",
    "vscode:prepublish": "node ../tools/sync-readme.mjs && npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "licenses:generate": "generate-license-file --output THIRD_PARTY_NOTICES.txt --overwrite"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.1",
    "eslint": "^9.23.0",
    "madge": "^8.0.0",
    "minisearch": "^7.1.2",
    "npm-run-all": "^4.1.5",
    "simple-git": "^3.27.0",
    "typescript": "^5.8.2"
  }
}
