{
  "name": "ai-code-review",
  "displayName": "ai-code-review",
  "description": "AI-powered code review for F# and WebSharper",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "AI Code Review",
      "properties": {
        "aiCodeReview.git.enable": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, accepted suggestions are snapshot-committed into a private shadow Git repo (keeps user repo untouched)."
        }
      }
    },
    "commands": [
      { 
        "command": "extension.showShadowHistory", 
        "title": "AI Code Review: Show Shadow Git History (Current File)" 
      },
      {
        "command": "extension.showSuggestion",
        "title": "AI Code Review: Show suggestion"
      },
      {
        "command": "extension.changeOllamaModel",
        "title": "AI Code Review: Change Ollama Model"
      },
      {
        "command": "extension.setAIPreferences",
        "title": "AI Code Review: Set AI Preferences"
      },
      {
        "command": "extension.showAIPreferences",
        "title": "AI Code Review: Show AI Preferences"
      },
      {
        "command": "extension.clearAIPreferences",
        "title": "AI Code Review: Clear AI Preferences"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.7.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.1",
    "eslint": "^9.23.0",
    "faiss-node": "^0.5.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2",
    "simple-git": "^3.27.0"
  }
}
